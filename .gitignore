# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

###
#
# Working directories, but allow the `cli.prettier.js` for `git add` staging during patch diff creation.
#
# 1. Ignore all the versioned directories entirely
[0-9]*.[0-9]*.[0-9]*/**

# 2. But, make an exception for the 'package' subdirectory
![0-9]*.[0-9]*.[0-9]*/package/

# 3. Now, re-ignore all content inside that 'package' subdirectory
[0-9]*.[0-9]*.[0-9]*/package/*

# 4. Finally, make an exception for the formatted file
![0-9]*.[0-9]*.[0-9]*/package/cli.prettier.js
