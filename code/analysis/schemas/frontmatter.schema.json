{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/local/claude-expert/main/code/analysis/schemas/frontmatter.schema.json",
  "title": "Claude Code Markdown Frontmatter",
  "description": "Validates the YAML frontmatter of Claude Code Markdown configuration files (agents, skills, output styles, memory). Verified against cli.prettier.js 2.1.296. See analysis/MARKDOWN_FRONTMATTER.md for narrative documentation. Use #/$defs/Agent, #/$defs/Skill, #/$defs/OutputStyle, or #/$defs/Memory as the entry point per file type.",
  "$defs": {
    "ModelAlias": {
      "description": "Model identifier. One of the documented aliases, the literal 'inherit', or a full Claude model ID (e.g. 'claude-sonnet-5-5'). Claude Code passes unknown strings through to the model resolver.",
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {
          "enum": [
            "sonnet",
            "opus",
            "haiku",
            "fable",
            "best",
            "sonnet[1m]",
            "opus[1m]",
            "fable[1m]",
            "opusplan",
            "inherit"
          ]
        },
        { "pattern": "^claude-" }
      ]
    },
    "Effort": {
      "description": "Thinking effort: a named preset or an integer token budget. Claude Code matches presets without regard to case and also accepts 'med' for 'medium'. 'ultracode' is a --effort CLI value only and is rejected in frontmatter.",
      "oneOf": [
        { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max", "med"] },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "PermissionMode": {
      "type": "string",
      "enum": ["acceptEdits", "auto", "bypassPermissions", "default", "dontAsk", "plan", "manual"],
      "description": "'manual' is accepted as an alias for 'default'."
    },
    "AgentColor": {
      "type": "string",
      "enum": ["red", "blue", "green", "yellow", "purple", "orange", "pink", "cyan"]
    },
    "MemoryScope": { "type": "string", "enum": ["user", "project", "local"] },
    "Isolation": {
      "type": "string",
      "enum": ["worktree", "remote"],
      "description": "Plugin agents accept only 'worktree'."
    },
    "ShellInterpreter": { "type": "string", "enum": ["bash", "powershell"] },
    "BooleanLike": {
      "description": "Strict boolean, as agent 'background' requires: a native boolean or the string 'true' / 'false'.",
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["true", "false"] }
      ]
    },
    "LenientBoolean": {
      "description": "Boolean read by the skill and output-style parsers: a native boolean, a number, or one of true/false, 1/0, yes/no, on/off in any case.",
      "oneOf": [
        { "type": "boolean" },
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^\\s*([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|1|0|[Yy][Ee][Ss]|[Nn][Oo]|[Oo][Nn]|[Oo][Ff][Ff])\\s*$"
        }
      ]
    },
    "ToolList": {
      "description": "A single string (comma- or space-separated tool names, or '*' for all tools) or a YAML list of tool names.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "PathsGlob": {
      "description": "Glob patterns: a string of comma-separated patterns, or a YAML list of strings. Commas inside braces do not split; {a,b} brace expansion is applied; a trailing '/**' is stripped; a bare '**' means no scoping.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "HookEvent": {
      "type": "string",
      "enum": [
        "PreToolUse",
        "PostToolUse",
        "PostToolUseFailure",
        "PostToolBatch",
        "Notification",
        "UserPromptSubmit",
        "UserPromptExpansion",
        "SessionStart",
        "SessionEnd",
        "Stop",
        "StopFailure",
        "SubagentStart",
        "SubagentStop",
        "PreCompact",
        "PostCompact",
        "PreModelSwitch",
        "PostModelSwitch",
        "PermissionRequest",
        "PermissionDenied",
        "Setup",
        "TeammateIdle",
        "TaskCreated",
        "TaskCompleted",
        "Elicitation",
        "ElicitationResult",
        "ConfigChange",
        "WorktreeCreate",
        "WorktreeRemove",
        "InstructionsLoaded",
        "CwdChanged",
        "FileChanged",
        "DirectoryAdded",
        "MessageDisplay"
      ]
    },
    "HookOnFailure": {
      "description": "What a hook failure does. 'continue' (default) reports it and lets the action proceed; 'block' treats it as exit code 2. Ignored for async hooks and on Stop, SubagentStop, TaskCompleted and TeammateIdle.",
      "type": "string",
      "enum": ["continue", "block"]
    },
    "HookCloud": {
      "description": "@internal: whether a cloud session driven from this machine may run this hook. Unrecognised values read as 'skip'.",
      "type": "string",
      "enum": ["device", "skip"]
    },
    "CommandHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": {
        "type": { "const": "command" },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "description": "Argument list for exec form. When present, 'command' is spawned directly without a shell.",
          "type": "array",
          "items": { "type": "string" }
        },
        "if": {
          "description": "Permission-rule filter (e.g. 'Bash(git *)'). Hook runs only when the tool call matches.",
          "type": "string"
        },
        "shell": { "$ref": "#/$defs/ShellInterpreter" },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "onFailure": { "$ref": "#/$defs/HookOnFailure" },
        "statusMessage": { "type": "string" },
        "once": { "type": "boolean" },
        "async": { "type": "boolean" },
        "asyncRewake": {
          "description": "If true, hook runs in background and wakes the model on exit code 2. Implies async.",
          "type": "boolean"
        },
        "rewakeMessage": { "type": "string", "minLength": 1 },
        "rewakeSummary": { "type": "string", "minLength": 1 },
        "cloud": { "$ref": "#/$defs/HookCloud" }
      }
    },
    "PromptHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt"],
      "properties": {
        "type": { "const": "prompt" },
        "prompt": { "type": "string" },
        "if": { "type": "string" },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "model": { "type": "string" },
        "continueOnBlock": { "type": "boolean" },
        "statusMessage": { "type": "string" },
        "once": { "type": "boolean" }
      }
    },
    "HttpHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "http" },
        "url": { "type": "string", "format": "uri" },
        "if": { "type": "string" },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "onFailure": { "$ref": "#/$defs/HookOnFailure" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "allowedEnvVars": { "type": "array", "items": { "type": "string" } },
        "statusMessage": { "type": "string" },
        "once": { "type": "boolean" },
        "cloud": { "$ref": "#/$defs/HookCloud" }
      }
    },
    "AgentHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt"],
      "properties": {
        "type": { "const": "agent" },
        "prompt": { "type": "string" },
        "if": { "type": "string" },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "model": { "type": "string" },
        "statusMessage": { "type": "string" },
        "once": { "type": "boolean" }
      }
    },
    "McpToolHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "server", "tool"],
      "properties": {
        "type": { "const": "mcp_tool" },
        "server": { "type": "string" },
        "tool": { "type": "string" },
        "input": {
          "description": "Arguments passed to the MCP tool. String values support ${path} interpolation from the hook input JSON.",
          "type": "object"
        },
        "if": { "type": "string" },
        "timeout": { "type": "number", "exclusiveMinimum": 0 },
        "statusMessage": { "type": "string" },
        "once": { "type": "boolean" }
      }
    },
    "Hook": {
      "description": "A single hook entry, discriminated by 'type'.",
      "oneOf": [
        { "$ref": "#/$defs/CommandHook" },
        { "$ref": "#/$defs/PromptHook" },
        { "$ref": "#/$defs/HttpHook" },
        { "$ref": "#/$defs/AgentHook" },
        { "$ref": "#/$defs/McpToolHook" }
      ]
    },
    "HookMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hooks"],
      "properties": {
        "matcher": {
          "description": "String pattern to match. Tool name ('Bash'), pipe-separated list ('Edit|Write'), or empty/absent to match all.",
          "type": "string"
        },
        "hooks": { "type": "array", "items": { "$ref": "#/$defs/Hook" } }
      },
      "description": "Matcher group. Only 'matcher' and 'hooks' are fields; Claude Code strips any other key, including 'if', without a warning. Put 'if' on each hook entry."
    },
    "Hooks": {
      "description": "Hook registrations, keyed by event name. Values are arrays of matcher groups. An invalid PreToolUse or PermissionRequest entry stops an agent loading and strips a skill's hooks and allowed-tools; other invalid entries and unknown events are dropped with a warning.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/HookEvent" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/HookMatcher" } }
    },
    "McpRole": {
      "description": "Role marker. Only 'comms' is recognised; Claude Code drops other values silently.",
      "type": "string",
      "enum": ["comms"]
    },
    "McpOAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string" },
        "callbackPort": { "type": "integer", "exclusiveMinimum": 0 },
        "authServerMetadataUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "scopes": { "type": "string", "minLength": 1 },
        "xaa": { "type": "boolean" }
      }
    },
    "McpServerStdio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "type": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "alwaysLoad": { "type": "boolean" },
        "bareElicitationCapability": { "type": "boolean" },
        "role": { "$ref": "#/$defs/McpRole" }
      }
    },
    "McpServerSse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "sse" },
        "url": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "headersHelper": { "type": "string" },
        "oauth": { "$ref": "#/$defs/McpOAuth" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "permission_policy": {
                "type": "string",
                "enum": ["always_allow", "always_ask", "always_deny"]
              }
            }
          }
        },
        "alwaysLoad": { "type": "boolean" },
        "bareElicitationCapability": { "type": "boolean" },
        "discoveryCache": { "type": "boolean" },
        "role": { "$ref": "#/$defs/McpRole" },
        "toolPermissions": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["allow", "ask", "blocked"] }
        }
      }
    },
    "McpServerSseIde": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "ideName"],
      "properties": {
        "type": { "const": "sse-ide" },
        "url": { "type": "string" },
        "ideName": { "type": "string" },
        "ideRunningInWindows": { "type": "boolean" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "alwaysLoad": { "type": "boolean" },
        "role": { "$ref": "#/$defs/McpRole" }
      }
    },
    "McpServerWsIde": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "ideName"],
      "properties": {
        "type": { "const": "ws-ide" },
        "url": { "type": "string" },
        "ideName": { "type": "string" },
        "authToken": { "type": "string" },
        "ideRunningInWindows": { "type": "boolean" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "alwaysLoad": { "type": "boolean" },
        "role": { "$ref": "#/$defs/McpRole" }
      }
    },
    "McpServerHttp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "description": "'streamable-http' is accepted and normalised to 'http' at load time.",
          "type": "string",
          "enum": ["http", "streamable-http"]
        },
        "url": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "headersHelper": { "type": "string" },
        "oauth": { "$ref": "#/$defs/McpOAuth" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "permission_policy": {
                "type": "string",
                "enum": ["always_allow", "always_ask", "always_deny"]
              }
            }
          }
        },
        "alwaysLoad": { "type": "boolean" },
        "bareElicitationCapability": { "type": "boolean" },
        "discoveryCache": { "type": "boolean" },
        "role": { "$ref": "#/$defs/McpRole" },
        "toolPermissions": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["allow", "ask", "blocked"] }
        }
      }
    },
    "McpServerWs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "ws" },
        "url": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "headersHelper": { "type": "string" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "alwaysLoad": { "type": "boolean" },
        "bareElicitationCapability": { "type": "boolean" },
        "role": { "$ref": "#/$defs/McpRole" }
      }
    },
    "McpServerSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "sdk" },
        "name": { "type": "string" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "alwaysLoad": { "type": "boolean" },
        "disableAutoBackground": { "type": "boolean" }
      }
    },
    "McpServerClaudeAiProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "id"],
      "properties": {
        "type": { "const": "claudeai-proxy" },
        "url": { "type": "string" },
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "iconUrl": { "type": "string" },
        "timeout": { "type": "integer", "exclusiveMinimum": 0 },
        "alwaysLoad": { "type": "boolean" },
        "toolPermissions": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["allow", "ask", "blocked"] }
        },
        "stateless": { "type": "boolean" },
        "cachedInitResponse": { "type": ["object", "null"] },
        "discoverSupport": { "type": "string", "enum": ["supported", "legacy", "unknown"] },
        "cachedDiscoverResponse": { "type": ["object", "null"] },
        "eligible": { "type": ["boolean", "null"] },
        "ineligibleReason": { "type": ["string", "null"] },
        "enterpriseManaged": { "type": "boolean" }
      }
    },
    "McpServer": {
      "description": "A single MCP server definition.",
      "oneOf": [
        { "$ref": "#/$defs/McpServerStdio" },
        { "$ref": "#/$defs/McpServerSse" },
        { "$ref": "#/$defs/McpServerSseIde" },
        { "$ref": "#/$defs/McpServerWsIde" },
        { "$ref": "#/$defs/McpServerHttp" },
        { "$ref": "#/$defs/McpServerWs" },
        { "$ref": "#/$defs/McpServerSdk" },
        { "$ref": "#/$defs/McpServerClaudeAiProxy" }
      ]
    },
    "AgentMcpServerEntry": {
      "description": "Either a string reference to a named MCP server, or a one-key map from server name to server config.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/McpServer" },
          "minProperties": 1
        }
      ]
    },
    "Agent": {
      "type": "object",
      "title": "Agent frontmatter (.claude/agents/*.md)",
      "description": "Frontmatter schema for agent definition files. Required fields: name, description.",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "description": "Agent identifier (becomes agentType). Required. At most 256 characters, no leading '-', no ':'.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^-:][^:]*$"
        },
        "description": {
          "description": "When-to-use text shown in the Agent tool listing. Literal '\\n' escapes are expanded to real newlines. Required.",
          "type": "string",
          "minLength": 1
        },
        "model": { "$ref": "#/$defs/ModelAlias" },
        "tools": { "$ref": "#/$defs/ToolList" },
        "disallowedTools": { "$ref": "#/$defs/ToolList" },
        "color": { "$ref": "#/$defs/AgentColor" },
        "effort": { "$ref": "#/$defs/Effort" },
        "permissionMode": { "$ref": "#/$defs/PermissionMode" },
        "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/AgentMcpServerEntry" } },
        "hooks": { "$ref": "#/$defs/Hooks" },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "autoCompactWindow": {
          "description": "Auto-compact window for this agent, in tokens.",
          "type": "integer",
          "minimum": 100000,
          "maximum": 1000000
        },
        "skills": {
          "$ref": "#/$defs/ToolList",
          "description": "Skills preloaded for this agent: a string or a YAML list of skill names."
        },
        "initialPrompt": {
          "description": "Auto-submitted first message when this agent runs as the main session. Ignored for subagent spawns.",
          "type": "string"
        },
        "memory": { "$ref": "#/$defs/MemoryScope" },
        "background": { "$ref": "#/$defs/BooleanLike" },
        "omitClaudeMd": {
          "description": "If true, the agent runs without the user, project and local CLAUDE.md files when spawned as a subagent. Only true or 'true' turns it on.",
          "$ref": "#/$defs/BooleanLike"
        },
        "isolation": { "$ref": "#/$defs/Isolation" },
        "observer": {
          "description": "Agent type auto-spawned as a background observer whenever this agent runs.",
          "type": "string",
          "minLength": 1
        },
        "observerMessage": {
          "description": "Text appended to each activity digest sent to the observer.",
          "type": "string",
          "minLength": 1
        },
        "observeSubagents": {
          "description": "If false, subagents this agent spawns do not inherit its observer. Defaults to true.",
          "$ref": "#/$defs/BooleanLike"
        },
        "experimental": {
          "description": "Experimental per-agent options. Only 'cacheTtl' is read; other keys are ignored.",
          "type": ["object", "null"],
          "properties": {
            "cacheTtl": {
              "description": "Prompt cache TTL for this agent's requests. '1h' is ignored while a Claude subscription is in overage.",
              "type": "string",
              "enum": ["5m", "1h"]
            }
          }
        }
      }
    },
    "Skill": {
      "type": "object",
      "title": "Skill and command frontmatter (.claude/skills/<name>/SKILL.md, .claude/commands/**/*.md)",
      "description": "Frontmatter schema for SKILL.md and .claude/commands/*.md files (commands ignore 'name' and 'paths'). All fields are optional; a skill's identifier is the containing directory name. The Agent Skills field 'compatibility' is absent from Claude Code's strict validator (it records an unknown-key telemetry event, then has no effect), so this schema rejects it.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Display name override. Defaults to the directory name.",
          "type": ["string", "number", "boolean", "null"]
        },
        "description": {
          "description": "One-line summary shown in skill listings.",
          "type": ["string", "number", "boolean"]
        },
        "model": { "$ref": "#/$defs/ModelAlias" },
        "allowed-tools": { "$ref": "#/$defs/ToolList" },
        "disallowed-tools": {
          "description": "Tools removed while this skill is active. Cleared when the user sends the next message.",
          "$ref": "#/$defs/ToolList"
        },
        "disallowedTools": {
          "description": "Alias of 'disallowed-tools', read only when 'disallowed-tools' is absent.",
          "$ref": "#/$defs/ToolList"
        },
        "argument-hint": {
          "description": "Hint shown while typing the slash command. Coerced with String(): a YAML list such as [file] loses its brackets and joins items with commas, so quote bracketed hints.",
          "type": ["string", "number", "boolean", "null"]
        },
        "arguments": {
          "description": "Named argument slots. String is split on whitespace; arrays keep non-empty, non-numeric strings only.",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "disable-model-invocation": { "$ref": "#/$defs/LenientBoolean" },
        "user-invocable": { "$ref": "#/$defs/LenientBoolean" },
        "effort": { "$ref": "#/$defs/Effort" },
        "shell": { "$ref": "#/$defs/ShellInterpreter" },
        "version": {
          "description": "Version string. Passed through; not validated.",
          "type": ["string", "number", "boolean", "null"]
        },
        "when_to_use": {
          "description": "Guidance for when the model should reach for this skill. Note the underscore, not a hyphen.",
          "type": ["string", "number", "boolean", "null"]
        },
        "paths": { "$ref": "#/$defs/PathsGlob" },
        "hooks": { "$ref": "#/$defs/Hooks" },
        "context": {
          "description": "Execution context. 'fork' spawns a subagent; 'inline' (or absent) expands into the current conversation.",
          "type": ["string", "null"],
          "enum": ["fork", "inline", null]
        },
        "agent": {
          "description": "Agent type to spawn when context: fork.",
          "type": ["string", "number", "boolean", "null"]
        },
        "background": {
          "description": "Only for context: fork. Forks run as background agents by default; false keeps the caller waiting for the result.",
          "$ref": "#/$defs/LenientBoolean"
        },
        "fallback": {
          "$ref": "#/$defs/LenientBoolean",
          "description": "@internal — if true, yields to a same-suffix plugin or MCP skill when one is loaded."
        },
        "created_by": {
          "description": "@internal — provenance marker (e.g. 'dream-proposal').",
          "type": "string"
        },
        "improved_by": {
          "description": "@internal — provenance marker (e.g. 'dream-proposal').",
          "type": "string"
        },
        "mcpServers": {
          "description": "@internal — reserved for plugin tooling.",
          "type": ["object", "array", "null"]
